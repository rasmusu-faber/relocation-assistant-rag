# --- LLM provider: "ollama" (local) or "openai" (any OpenAI-compatible endpoint) ---
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible (used when LLM_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval ---
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Re-ranking (cross-encoder) ---
# When enabled, retrieve RERANK_CANDIDATES passages and re-order them to TOP_K.
RERANK_ENABLED=false
RERANK_CANDIDATES=20
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Tracing (optional, Langfuse) ---
# Leave the keys empty to disable. See the README ("Tracing with Langfuse").
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Storage ---
CHROMA_DIR=.chroma
COLLECTION_NAME=relocation
DATA_DIR=data
